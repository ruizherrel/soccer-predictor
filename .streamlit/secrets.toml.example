# Copy this file to .streamlit/secrets.toml (already gitignored -- never
# commit the real key) and fill in your own key to enable the app's
# market-odds / +EV / Kelly stake section on the prediction screen.
#
# Get a free key (500 requests/month) at https://the-odds-api.com --
# verify current pricing/terms yourself before relying on it, since they
# can change. Without this configured, the app still works exactly as
# before; it just skips the odds comparison section.
#
# On Streamlit Community Cloud, set this same key under
# "Manage app" -> "Settings" -> "Secrets" instead of uploading this file.

ODDS_API_KEY = "your-api-key-here"
